---
import { getCollection } from 'astro:content';
import ProjectDetail from '../../../components/pages/ProjectDetail.astro';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).filter((p) => p.data.status !== 'Deprecated');
  return projects.map((p) => ({ params: { slug: p.id }, props: { project: p } }));
}

const { project } = Astro.props;
---

<ProjectDetail locale="en" project={project} />

---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Related from '../Related.astro';
import { t, type Locale } from '../../i18n/ui';

interface Props {
  locale: Locale;
  entry: CollectionEntry<'symbols'>;
}
const { locale, entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---

<Base locale={locale} title={d.name}>
  <div class="wrap">
    <section class="reveal py-24">
      <p class="eyebrow d1 reveal mb-4">{t(locale, 'world.symbols')}</p>
      <h1 class="serif d2 reveal text-[clamp(38px,8vw,60px)] leading-tight font-light">{d.name}</h1>
    </section>

    <section class="serif reveal pb-20 text-[clamp(19px,3vw,23px)] italic leading-relaxed">
      <Content />
    </section>

    {
      d.firstAppearance && (
        <section class="reveal pb-16">
          <p class="eyebrow mb-6">{locale === 'es' ? 'Primera aparición' : 'First appearance'}</p>
          <p class="serif text-lg text-piedra">{d.firstAppearance}</p>
        </section>
      )
    }

    {
      d.appearances.length > 0 && (
        <section class="reveal pb-16">
          <p class="eyebrow mb-6">{t(locale, 'symbol.appearances')}</p>
          <p class="serif text-lg text-piedra">{d.appearances.join(' · ')}</p>
        </section>
      )
    }

    {
      d.readings.length > 0 && (
        <section class="reveal pb-16">
          <p class="eyebrow mb-6">{t(locale, 'symbol.readings')}</p>
          <p class="serif text-lg text-piedra">{d.readings.join(' · ')}</p>
        </section>
      )
    }

    <Related locale={locale} locations={d.locations} projects={d.projects} mentionsOf={{ collection: 'symbols', id: entry.id }} />
  </div>
</Base>

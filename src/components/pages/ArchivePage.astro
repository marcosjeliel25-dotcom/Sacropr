---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { t, type Locale } from '../../i18n/ui';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const prefix = locale === 'es' ? '' : '/en';
const es = locale === 'es';

const music = (await getCollection('music')).sort((a, b) => a.data.order - b.data.order);
const projects = (await getCollection('projects')).filter((p) => p.data.status !== 'Deprecated');
const kindEn: Record<string, string> = { Sencillo: 'Single', Álbum: 'Album' };
const kindOf = (k: string) => (es ? k : (kindEn[k] ?? k));

type Item = { title: string; kind?: string; href?: string };
type Era = { year: string; items: Item[] };

const released = (y: string) =>
  music
    .filter((m) => m.data.status === 'released' && m.data.year === y)
    .map((m) => ({ title: m.data.title, kind: kindOf(m.data.kind), href: `${base}${prefix}/musica/${m.id}` }));

const upcoming = music
  .filter((m) => m.data.status === 'upcoming')
  .map((m) => ({ title: m.data.title, kind: kindOf(m.data.kind), href: `${base}${prefix}/musica/${m.id}` }));

const daaa = projects.find((p) => p.id === 'del-amor-al-arte');

const timeline: Era[] = [
  {
    year: '2023',
    items: [
      { title: es ? 'La música deja de ser una posibilidad.' : 'Music stops being a possibility.' },
      { title: es ? 'Primeras presentaciones en vivo.' : 'First live performances.' },
    ],
  },
  { year: '2024', items: released('2024') },
  {
    year: es ? 'Octubre 2026' : 'October 2026',
    items: [
      ...upcoming,
      ...(daaa ? [{ title: daaa.data.title, kind: kindOf('Álbum'), href: `${base}${prefix}/proyectos/${daaa.id}` }] : []),
    ],
  },
  { year: '—', items: [{ title: es ? 'La historia continúa.' : 'The story continues.' }] },
];

const journal = (await getCollection('journal')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base locale={locale} title={t(locale, 'archive.title')}>
  <div class="wrap">
    <section class="reveal py-20">
      <p class="eyebrow d1 reveal mb-4">{t(locale, 'archive.title')}</p>
      <p class="serif d2 reveal text-[clamp(22px,3.4vw,28px)] italic">{t(locale, 'archive.intro')}</p>
    </section>

    {
      timeline.map((era) => (
        <section class="reveal pb-16">
          <p class="serif mb-8 text-[clamp(26px,4.6vw,36px)] font-light tracking-[0.14em] text-bronce">{era.year}</p>
          {era.items.map((r, i) => {
            const inner = (
              <>
                <span class="serif flex-1 text-[clamp(19px,3vw,24px)]">{r.title}</span>
                {r.kind && <span class="text-[10px] tracking-[0.26em] uppercase whitespace-nowrap text-piedra">{r.kind}</span>}
              </>
            );
            const cls = `hairline flex items-baseline gap-5 border-b py-5 ${i === 0 ? 'border-t' : ''}`;
            return r.href ? (
              <a class={`${cls} transition-colors duration-300 hover:text-bronce`} href={r.href}>
                {inner}
              </a>
            ) : (
              <div class={cls}>{inner}</div>
            );
          })}
        </section>
      ))
    }

    <section class="reveal pb-24">
      <p class="eyebrow mb-10">{t(locale, 'journal.title')}</p>
      {
        journal.slice(0, 3).map((e) => (
          <article class="hairline border-b py-6 first:border-t">
            <time class="text-[11px] tracking-[0.18em] text-piedra" datetime={e.data.date.toISOString().slice(0, 10)}>
              {e.data.date.toLocaleDateString(es ? 'es-PR' : 'en-US', { month: 'long', day: 'numeric' })}
            </time>
            <p class="serif mt-1 text-xl italic">{e.body?.trim()}</p>
          </article>
        ))
      }
      <p class="mt-8">
        <a href={`${base}${prefix}/diario`} class="inline-block py-2 text-[12px] tracking-[0.32em] uppercase text-piedra transition-colors duration-300 hover:text-bronce">
          {t(locale, 'journal.title')} <span class="serif text-bronce">→</span>
        </a>
      </p>
    </section>
  </div>
</Base>

---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Bird from '../Bird.astro';
import { t, type Locale } from '../../i18n/ui';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const es = locale === 'es';

const kindEn: Record<string, string> = { Sencillo: 'Single', Álbum: 'Album' };
const releases = (await getCollection('music'))
  .filter((m) => m.data.status === 'released' && m.data.spotify)
  .sort((a, b) => a.data.order - b.data.order)
  .map((m) => ({
    year: m.data.year,
    title: m.data.title,
    kind: es ? m.data.kind : (kindEn[m.data.kind] ?? m.data.kind),
    href: m.data.spotify!,
  }));

const listen = [
  { label: 'Spotify', href: 'https://open.spotify.com/artist/3gy7JBS79nEvQ2jDORrBCx' },
  { label: 'Apple Music', href: 'https://music.apple.com/us/artist/sacro/1701623595' },
  { label: 'YouTube', href: 'https://youtube.com/@laesquinadesacro' },
  { label: 'Instagram', href: 'https://www.instagram.com/sacropr' },
];

const contact = [
  { label: 'Marcosjeliel25@gmail.com', href: 'mailto:Marcosjeliel25@gmail.com' },
  { label: '+1 787 366 5330', href: 'tel:+17873665330' },
];
---

<Base locale={locale} bare>
  <header class="flex min-h-svh flex-col items-center justify-center px-6 text-center">
    <div class="reveal mb-11">
      <Bird />
    </div>
    <h1 class="reveal d1 serif text-[clamp(58px,13vw,110px)] leading-none font-light tracking-[0.4em] -mr-[0.4em]">SACRO</h1>
    <p class="reveal d2 serif mt-10 text-[clamp(17px,2.8vw,21px)] italic">{t(locale, 'home.sentence')}</p>
    <div class="reveal d3 rule mt-11" aria-hidden="true"></div>
  </header>

  <div class="wrap">
    <section class="reveal py-24">
      <p class="eyebrow mb-12">{es ? 'Música' : 'Music'}</p>
      {
        releases.map((r, i) => (
          <a
            class={`hairline flex items-baseline gap-5 border-b py-6 transition-colors duration-300 ${i === 0 ? 'border-t' : ''}`}
            href={r.href}
            target="_blank"
            rel="noopener"
          >
            <span class="min-w-12 text-[11px] tracking-[0.18em] text-piedra">{r.year}</span>
            <span class="serif flex-1 text-[clamp(21px,3.4vw,26px)] transition-colors duration-300 hover:text-bronce">{r.title}</span>
            <span class="text-[10px] tracking-[0.26em] uppercase whitespace-nowrap text-piedra">{r.kind}</span>
          </a>
        ))
      }
    </section>
  </div>

  <section class="reveal mt-6 bg-tinta px-6 py-32 text-center text-marfil">
    <div class="rule mx-auto mb-10" aria-hidden="true"></div>
    <h2 class="serif text-[clamp(38px,8vw,64px)] leading-tight font-light tracking-[0.22em] -mr-[0.22em]">
      {es ? 'OCTUBRE 2026' : 'OCTOBER 2026'}
    </h2>
    <p class="serif mt-6 text-[clamp(17px,2.8vw,20px)] italic opacity-75">
      {es ? 'La historia continúa.' : 'The story continues.'}
    </p>
  </section>

  <div class="wrap">
    <section class="reveal py-24">
      <p class="eyebrow mb-12">{t(locale, 'listen.title')}</p>
      <div class="flex flex-col">
        {
          listen.map((l, i) => (
            <a
              href={l.href}
              target="_blank"
              rel="noopener"
              class={`hairline flex items-center justify-between border-b py-5 text-[12px] tracking-[0.32em] uppercase transition-colors duration-300 hover:text-bronce ${i === 0 ? 'border-t' : ''}`}
            >
              {l.label} <span class="serif text-lg text-bronce">→</span>
            </a>
          ))
        }
      </div>
    </section>

    <section class="reveal pb-16">
      <p class="eyebrow mb-12">{t(locale, 'contact.title')}</p>
      <div class="flex flex-col">
        {
          contact.map((c, i) => (
            <a
              href={c.href}
              class={`hairline flex items-center justify-between border-b py-5 text-[12px] tracking-[0.32em] uppercase transition-colors duration-300 hover:text-bronce ${i === 0 ? 'border-t' : ''}`}
            >
              {c.label} <span class="serif text-lg text-bronce">→</span>
            </a>
          ))
        }
      </div>
    </section>
  </div>
</Base>

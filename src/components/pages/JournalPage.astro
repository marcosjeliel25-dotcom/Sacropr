---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { t, type Locale } from '../../i18n/ui';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const entries = (await getCollection('journal')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base locale={locale} title={t(locale, 'journal.title')}>
  <div class="wrap">
    <section class="py-16">
      <p class="eyebrow mb-12">{t(locale, 'journal.title')}</p>
      {
        entries.map((e) => (
          <article class="hairline border-b py-8 first:border-t">
            <time class="text-[11px] tracking-[0.18em] text-piedra" datetime={e.data.date.toISOString().slice(0, 10)}>
              {e.data.date.toLocaleDateString(locale === 'es' ? 'es-PR' : 'en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
            </time>
            <p class="serif mt-2 text-[clamp(19px,3vw,23px)]">{e.body?.trim()}</p>
          </article>
        ))
      }
    </section>
  </div>
</Base>

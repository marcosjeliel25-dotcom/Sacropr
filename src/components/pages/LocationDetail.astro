---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { t, type Locale } from '../../i18n/ui';

interface Props {
  locale: Locale;
  entry: CollectionEntry<'locations'>;
}
const { locale, entry } = Astro.props;
const { Content } = await render(entry);
---

<Base locale={locale} title={entry.data.name}>
  <div class="wrap">
    <section class="py-16">
      <p class="eyebrow mb-3">{entry.data.region ?? t(locale, 'world.locations')}</p>
      <h1 class="serif text-[clamp(38px,8vw,60px)] leading-tight font-light">{entry.data.name}</h1>
    </section>

    <section class="serif pb-12 text-[clamp(19px,3vw,23px)] italic leading-relaxed">
      <Content />
    </section>

    {
      entry.data.connected.length > 0 && (
        <section class="pb-20">
          <p class="eyebrow mb-6">{t(locale, 'location.connected')}</p>
          <p class="serif text-lg text-piedra">{entry.data.connected.join(' · ')}</p>
        </section>
      )
    }
  </div>
</Base>

---
import { getCollection } from 'astro:content';
import { t, type Locale } from '../i18n/ui';

type Coll = 'symbols' | 'locations' | 'projects' | 'music';

interface Props {
  locale: Locale;
  /** the entry this page belongs to; used to compute reverse links */
  self: { collection: Coll; id: string };
  /** relations declared on this entry's own frontmatter */
  symbols?: string[];
  locations?: string[];
  projects?: string[];
  music?: string[];
}

const { locale, self, symbols = [], locations = [], projects = [], music = [] } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const prefix = locale === 'es' ? '' : '/en';
const es = locale === 'es';

const all = {
  symbols: await getCollection('symbols'),
  locations: await getCollection('locations'),
  projects: (await getCollection('projects')).filter((p) => p.data.status !== 'Deprecated'),
  music: await getCollection('music'),
  creation: await getCollection('creation'),
};
const allJournal = await getCollection('journal');

const kindEn: Record<string, string> = { Sencillo: 'Single', Álbum: 'Album', Era: 'Era' };
const label = (kind: string) => (es ? kind : (kindEn[kind] ?? kind));

type Link = { label: string; kind: string; href: string };
const seen = new Set<string>();
const links: Link[] = [];
function add(l: Link) {
  if (l.href === `${base}${prefix}/${routeOf(self.collection)}/${self.id}`) return;
  if (seen.has(l.href)) return;
  seen.add(l.href);
  links.push(l);
}
function routeOf(c: Coll) {
  return { symbols: 'mundo/simbolos', locations: 'mundo/lugares', projects: 'proyectos', music: 'musica' }[c];
}
function linkFor(c: Coll, e: any): Link {
  const title = 'name' in e.data ? e.data.name : e.data.title;
  const kind =
    c === 'symbols'
      ? t(locale, 'world.symbols')
      : c === 'locations'
        ? t(locale, 'world.locations')
        : label(e.data.kind);
  return { label: title, kind, href: `${base}${prefix}/${routeOf(c)}/${e.id}` };
}

// declared relations
const declared: [Coll, string[]][] = [
  ['music', music],
  ['projects', projects],
  ['symbols', symbols],
  ['locations', locations],
];
for (const [c, ids] of declared) {
  for (const id of ids) {
    const e = all[c].find((x: any) => x.id === id);
    if (e) add(linkFor(c, e));
  }
}

// reverse relations: any entry anywhere that declares me
for (const c of ['music', 'projects', 'symbols', 'locations'] as Coll[]) {
  for (const e of all[c] as any[]) {
    const declaredRefs: string[] = (e.data as any)[self.collection] ?? [];
    if (declaredRefs.includes(self.id)) add(linkFor(c, e));
  }
}
// releases discovered from their era page is handled by ProjectDetail itself;
// but a release page should point back to its era
if (self.collection === 'music') {
  const me = all.music.find((m) => m.id === self.id);
  if (me?.data.era) {
    const era = all.projects.find((p) => p.id === me.data.era);
    if (era) add(linkFor('projects', era));
  }
}
// creation pieces that reference me appear as quiet rows
const creationRefs = all.creation.filter((e) => ((e.data as any)[self.collection] ?? []).includes(self.id));

// journal entries that mention me
const mentions = allJournal
  .filter((e) => ((e.data as any)[self.collection] ?? []).includes(self.id))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

{
  (links.length > 0 || mentions.length > 0 || creationRefs.length > 0) && (
    <section class="reveal pb-20">
      <p class="eyebrow mb-8">{t(locale, 'related.title')}</p>
      <div class="flex flex-col">
        {links.map((l, i) => (
          <a
            href={l.href}
            class={`hairline flex items-baseline justify-between gap-5 border-b py-4 transition-colors duration-300 hover:text-bronce ${i === 0 ? 'border-t' : ''}`}
          >
            <span class="serif text-[clamp(18px,2.8vw,22px)]">{l.label}</span>
            <span class="text-[10px] tracking-[0.26em] uppercase whitespace-nowrap text-piedra">{l.kind}</span>
          </a>
        ))}
        {creationRefs.map((e, i) => (
          <a
            href={`${base}${prefix}/creacion`}
            class={`hairline flex items-baseline justify-between gap-5 border-b py-4 transition-colors duration-300 hover:text-bronce ${links.length === 0 && i === 0 ? 'border-t' : ''}`}
          >
            <span class="serif text-[clamp(18px,2.8vw,22px)]">{e.data.title}</span>
            <span class="text-[10px] tracking-[0.26em] uppercase whitespace-nowrap text-piedra">{t(locale, 'creation.title')}</span>
          </a>
        ))}
        {mentions.map((e, i) => (
          <a
            href={`${base}${prefix}/diario#${e.id}`}
            class={`hairline flex items-baseline justify-between gap-5 border-b py-4 transition-colors duration-300 hover:text-bronce ${links.length === 0 && creationRefs.length === 0 && i === 0 ? 'border-t' : ''}`}
          >
            <span class="serif text-[clamp(18px,2.8vw,22px)] italic">{e.body?.trim()}</span>
            <span class="text-[10px] tracking-[0.26em] uppercase whitespace-nowrap text-piedra">
              {t(locale, 'journal.mentions')} · {e.data.date.toLocaleDateString(es ? 'es-PR' : 'en-US', { month: 'long', day: 'numeric' })}
            </span>
          </a>
        ))}
      </div>
    </section>
  )
}

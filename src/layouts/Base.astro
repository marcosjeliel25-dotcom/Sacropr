---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import '@fontsource/cormorant-garamond/300.css';
import '@fontsource/cormorant-garamond/400.css';
import '@fontsource/cormorant-garamond/400-italic.css';
import '@fontsource/jost/300.css';
import '@fontsource/jost/400.css';
import { t, type Locale } from '../i18n/ui';

interface Props {
  title?: string;
  description?: string;
  locale?: Locale;
  /** hide site chrome for the pure hero page */
  bare?: boolean;
}

const { title, description, locale = 'es', bare = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const prefix = locale === 'es' ? '' : '/en';
const pageTitle = title ? `${title} — SACRO` : 'SACRO';
const desc = description ?? t(locale, 'meta.description');

const nav = [
  { href: `${base}${prefix}/archivo`, label: t(locale, 'nav.archive') },
  { href: `${base}${prefix}/proyectos`, label: t(locale, 'nav.projects') },
  { href: `${base}${prefix}/mundo`, label: t(locale, 'nav.world') },
  { href: `${base}${prefix}/creacion`, label: t(locale, 'nav.creation') },
  { href: `${base}${prefix}/diario`, label: t(locale, 'nav.journal') },
  { href: `${base}${prefix}/contacto`, label: t(locale, 'nav.contact') },
];

const listen = [
  { label: 'Spotify', href: 'https://open.spotify.com/artist/3gy7JBS79nEvQ2jDORrBCx' },
  { label: 'Apple Music', href: 'https://music.apple.com/us/artist/sacro/1701623595' },
  { label: 'YouTube', href: 'https://youtube.com/@laesquinadesacro' },
  { label: 'Instagram', href: 'https://www.instagram.com/sacropr' },
];

// swap locale, keep the same path
const path = Astro.url.pathname.replace(base, '').replace(/^\/en/, '') || '/';
const esHref = `${base}${path}`;
const enHref = `${base}/en${path === '/' ? '' : path}`;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <meta name="generator" content={Astro.generator} />
    <ClientRouter />
  </head>
  <body>
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-marfil focus:px-4 focus:py-2 focus:text-tinta"
      >{locale === 'es' ? 'Saltar al contenido' : 'Skip to content'}</a
    >

    <nav class="fixed top-5 right-6 z-50 flex gap-1 text-[11px] tracking-[0.22em]" aria-label={locale === 'es' ? 'Idioma' : 'Language'}>
      <a href={esHref} class={`inline-block p-1 ${locale === 'es' ? 'text-bronce' : 'text-piedra'}`} aria-current={locale === 'es' ? 'true' : undefined}>ES</a>
      <span class="p-1 text-piedra" aria-hidden="true">·</span>
      <a href={enHref} class={`inline-block p-1 ${locale === 'en' ? 'text-bronce' : 'text-piedra'}`} aria-current={locale === 'en' ? 'true' : undefined}>EN</a>
    </nav>

    {
      !bare && (
        <header class="wrap pt-14 pb-4">
          <a href={`${base}${prefix}/`} class="serif inline-block py-1 text-2xl tracking-[0.4em]">
            SACRO
          </a>
          <nav aria-label={locale === 'es' ? 'Principal' : 'Main'} class="mt-5 flex flex-wrap gap-x-6 gap-y-1 text-[11px] tracking-[0.32em] uppercase">
            {nav.map((item) => (
              <a href={item.href} class="inline-block py-2 text-piedra transition-colors duration-300 hover:text-bronce">
                {item.label}
              </a>
            ))}
          </nav>
        </header>
      )
    }

    <main id="contenido">
      <slot />
    </main>

    <footer class="wrap py-16 text-center">
      {
        !bare && (
          <div class="mb-8 flex flex-wrap items-center justify-center gap-x-7 gap-y-2 text-[10px] tracking-[0.3em] uppercase">
            {listen.map((l) => (
              <a href={l.href} target="_blank" rel="noopener" class="inline-block py-2 text-piedra transition-colors duration-300 hover:text-bronce">
                {l.label}
              </a>
            ))}
          </div>
        )
      }
      <span class="text-[10px] tracking-[0.3em] uppercase text-piedra">© MMXXVI Sacro Media</span>
    </footer>

    <script>
      function watchReveals() {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('in');
                io.unobserve(e.target);
              }
            }
          },
          { threshold: 0.15 }
        );
        document.querySelectorAll('.reveal:not(.in)').forEach((el) => io.observe(el));
      }
      watchReveals();
      document.addEventListener('astro:page-load', watchReveals);
    </script>
  </body>
</html>
